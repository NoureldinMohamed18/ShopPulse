# Copy to .env and edit. Every variable is optional - defaults run fully offline.
SHOPPULSE_DATA_DIR=data
# MONGO_URI=mongodb://localhost:27017     # unset = in-memory MongoDB (mongomock)
SHOPPULSE_API_KEY=change-me               # required header X-API-Key for POST/PATCH
RATES_URL=https://open.er-api.com/v6/latest/USD
CATALOG_BASE_URL=https://books.toscrape.com
SCRAPE_DELAY=1.0
LOG_LEVEL=INFO
